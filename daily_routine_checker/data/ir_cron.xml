<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="routine_check_daily_challenge_reminder_cron" model="ir.cron">
        <field name="name">Reminder: Todays Challenge Miss </field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- 8PM Daily -->
        <field name="nextcall"
            eval="(DateTime.utcnow().replace(hour=14, minute=30, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="model_id" ref="model_daily_routine_checker"/>
        <field name="state">code</field>
        <field name="code">model._todays_challenge_reminder()</field>
        <field name="active">True</field>
    </record>

    <record id="routine_check_daily_log_cron" model="ir.cron">
        <field name="name">Daily Routine Update</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- 10 PM Daily -->
        <field name="nextcall"
            eval="(DateTime.utcnow().replace(hour=16, minute=30, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="model_id" ref="model_daily_routine_checker"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily_logs_routine_checker()</field>
        <field name="active">True</field>
    </record>
    <record id="routine_missed_log_cron" model="ir.cron">
        <field name="name">Challenge Missed: Reminder Send by Email</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- 10:30 PM Daily -->
        <field name="nextcall"
            eval="(DateTime.utcnow().replace(hour=17, minute=00, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="model_id" ref="model_daily_routine_checker"/>
        <field name="state">code</field>
        <field name="code">model.send_missed_reminder()</field>
        <field name="active">True</field>
    </record>
</odoo>