<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate="1" -->
<odoo >
    <!-- User → Only their own record -->
    <record id="daily_routine_checker_user_rule" model="ir.rule">
        <field name="name">User Own Records</field>
        <field name="model_id" ref="model_daily_routine_checker"/>
        <field name="groups" eval="[(4, ref('group_routine_check_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- Manager → Can see all users' records -->
    <record id="daily_routine_checker_manager_rule" model="ir.rule">
        <field name="name">Manager All Records</field>
        <field name="model_id" ref="model_daily_routine_checker"/>
        <field name="groups" eval="[(4, ref('group_routine_check_progress_manager'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <!-- Admin → See everything -->
    <record id="daily_routine_checker_admin_rule" model="ir.rule">
        <field name="name">Admin All Records</field>
        <field name="model_id" ref="model_daily_routine_checker"/>
        <field name="groups" eval="[(4, ref('group_routine_check_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>
</odoo>