<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- User -->
    <record id="group_routine_check_user" model="res.groups">
        <field name="name">Challenge User</field>
    </record>

    <!-- Manager -->
    <record id="group_routine_check_progress_manager" model="res.groups">
        <field name="name">Challenge Manager</field>
        <!-- <field name="category_id" ref="base.module_category_hidden"/> -->
    </record>
    <!-- Admin -->
    <record id="group_routine_check_admin" model="res.groups">
        <field name="name">Challenge Admin</field>
        <field name="implied_ids" eval="[(4, ref('group_routine_check_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>