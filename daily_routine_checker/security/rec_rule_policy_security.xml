<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rec_rule_policy_category" model="ir.module.category">
        <field name="name">Policy Rule</field>
    </record>

    <record id="rec_rule_policy_sub_module_category" model="res.groups.privilege">
        <field name="name">Access Rights</field>
        <field name="category_id" ref="daily_routine_checker.rec_rule_policy_category"/>
        <field name="sequence">8</field>
        <field name="description">Using this group you can allow user to access below rights.
            1) Employee Access :- Only its own profile access.
            2) Manager access :- All Employee accessed by assigned under Employee profile.
            3) Administrator :- All Employee can see + Remove feature.
        </field>
    </record>

    <record id="employee_own_group" model="res.groups">
        <field name="name">Employee</field>
        <field name="privilege_id" ref="daily_routine_checker.rec_rule_policy_sub_module_category" />
    </record>
    <record id="employee_manager_group" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="daily_routine_checker.rec_rule_policy_sub_module_category" />
        <field name="implied_ids" eval="[(4, ref('daily_routine_checker.employee_own_group'))]" />
    </record>
    <record id="employee_manager_admin_group" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="daily_routine_checker.rec_rule_policy_sub_module_category" />
        <field name="implied_ids" eval="[(4, ref('daily_routine_checker.employee_manager_group'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="employee_rule_id" model="ir.rule">
        <field name="name">Employee: Own Records Only</field>
        <field name="model_id" ref="model_rec_rule_policy" />
        <!-- <field name="domain_force">[('student_user_id','=',user.id)]</field> -->
        <field name="groups" eval="[(4, ref('daily_routine_checker.employee_own_group'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="manager_rule_id" model="ir.rule">
        <field name="name">Manager: Assigned Employee Records Only</field>
        <field name="model_id" ref="model_rec_rule_policy" />
        <!-- <field name="domain_force">[('student_user_id','=',user.id)]</field> -->
        <field name="groups" eval="[(4, ref('daily_routine_checker.employee_manager_group'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="admin_rule_id" model="ir.rule">
        <field name="name">Employee: Own Records Only</field>
        <field name="model_id" ref="model_rec_rule_policy" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('daily_routine_checker.employee_manager_admin_group'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>