<?xml version="1.0"?>
<odoo>
    <record id="daily_routine_checker_list_view" model="ir.ui.view">
        <field name="name">daily.routine.checker.list</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <list string="Daily Routine Checker" decoration-success="" decoration-bf="" decoration-muted="">
                <field name="name"/>
                <field name="description"/>
                <field name="challenge_accept_datetime"/>
                <field name="no_of_days_challenge"/>
                
            </list>
        </field>
    </record>
    <record id="daily_routine_checker_form_view" model="ir.ui.view">
        <field name="name">daily.routine.checker.form</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <form string="Daily Routine Checker">
                <header>
                    <field name="active" invisible="True"/>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1 class="mb32">
                            <field name="name" class="mb16"/> 
                        </h1> 
                    </div><br/>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="challenge_accept_datetime"/>
                            <field name="no_of_days_challenge" readonly="no_of_days_challenge != False" force_save="1"/> 
                        </group>
                        <group>
                            <field name="missed_streak"/>
                            <field name="missed_streak_date"/>
                            <field name="current_streak"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="employee_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daily Routine Mark">
                            <field name="routine_line_ids" />
                        </page>
                        <page string="Odoo Practise">
                            <field name="odoo_practise_line_ids" />
                        </page>
                        <page string="Interview">
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>
    <record id="daily_routine_checker_kanban_view" model="ir.ui.view">
        <field name="name">daily.routine.checker.view.kanban</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <kanban >
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bolder"/>
                        <!-- <div>
                            Mobile Number: <field name="mobile"/>
                        </div> -->
                        <!-- <div>
                            <strong>Expected Price: </strong><field name="expected_price"/>
                        </div> -->
                        <!-- <div invisible="state != 'offer_received'">
                            Best Price: <field name="best_price"/>
                        </div> -->
                       
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="daily_routine_checker_graph_view" model="ir.ui.view">
        <field name="name">daily.routine.checker</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <graph string="Challenge Performance" type="bar">
                <field name="employee_id"/>
                <field name="current_streak" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="daily_routine_checker_action" model="ir.actions.act_window">
        <field name="name">Daily Routine Checker</field>
        <field name="res_model">daily.routine.checker</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
          <p>Create a new Routine</p>
        </field>
    </record>

    <record id="view_daily_routine_checker_tree_leaderboard" model="ir.ui.view">
        <field name="name">daily.routine.checker.leaderboard.tree</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <list default_order="current_streak desc">
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="current_streak"/>
                <field name="progress"/>
            </list>
        </field>
    </record>

    <!-- Leaderboard Action -->
    <record id="action_daily_routine_checker_leaderboard" model="ir.actions.act_window">
        <field name="name">Leaderboard</field>
        <field name="res_model">daily.routine.checker</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','running')]</field>
    </record>
</odoo>