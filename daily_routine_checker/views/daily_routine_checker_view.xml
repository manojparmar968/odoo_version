<?xml version="1.0"?>
<odoo>
    <record id="daily_routine_checker_list_view" model="ir.ui.view">
        <field name="name">daily.routine.checker.list</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <list string="Daily Routine Checker" decoration-success="" decoration-bf="" decoration-muted="">
                <field name="name"/>
                <field name="description"/>
                <field name="challenge_accept_datetime"/>
                <field name="no_of_days_challenge"/>
                
            </list>
        </field>
    </record>
    <record id="daily_routine_checker_form_view" model="ir.ui.view">
        <field name="name">daily.routine.checker.form</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <form string="Daily Routine Checker">
                <header>
                    <field name="active" invisible="True"/>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1 class="mb32">
                            <field name="name" class="mb16"/> 
                        </h1> 
                    </div><br/>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="challenge_accept_datetime"/>
                            <field name="no_of_days_challenge" readonly="no_of_days_challenge != False" force_save="1"/> 
                            <field name="manager_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                            <field name="token"/>
                        </group>
                        <group>
                            <field name="missed_streak"/>
                            <field name="missed_streak_date"/>
                            <field name="current_streak"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="user_id" options="{'no_open': True, 'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="employee_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daily Routine Mark" name="daily_routine_mark">
                            <group>
                                <field name="routine_line_ids" nolabel="1"/>
                            </group>
                            <group></group>
                        </page>
                        <page string="Odoo Practise" name="odoo_practise">
                            <field name="odoo_practise_line_ids" />
                        </page>
                        <page string="Shift" name="shift">
                            <!-- <group> -->
                                <div class="row">
                                    <div class="col-lg-4">
                                        <separator string="Shift A 9AM : 3PM" class="text-center"/>
                                        <field name="shift_first_ids" nolabel="1">
                                            <list editable="bottom" delete="0">
                                                <field name="shift_start"/>
                                                <field name="shift_end"/>
                                            </list>
                                        </field>
                                    </div>
                                    <div class="col-lg-4">
                                        <separator string="Shift B 3PM : 6PM" class="text-center"/>
                                        <field name="shift_second_ids" nolabel="1">
                                            <list editable="bottom" delete="0">
                                                <field name="shift_start"/>
                                                <field name="shift_end"/>
                                            </list>
                                        </field>
                                    </div>
                                    <div class="col-lg-4">
                                        <separator string="Shift C 6PM : 9PM" class="text-center"/>
                                        <field name="shift_third_ids" nolabel="1">
                                            <list editable="bottom" delete="0">
                                                <field name="shift_start"/>
                                                <field name="shift_end"/>
                                            </list>
                                        </field>
                                    </div>
                                </div>
                            <!-- </group> -->
                        </page>
                        <page string="Interview" name="interview">
                            <field name="interview_line_ids" />
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>
    <record id="daily_routine_checker_kanban_view" model="ir.ui.view">
        <field name="name">daily.routine.checker.view.kanban</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <kanban >
                <templates>
                    <t t-name="card">
                        <strong class="text-center"><field name="user_id"/></strong>
                        <field name="name" class="fw-bolder"/>
                        <!-- <field name=""/> -->
                        <div>
                            <strong>State: </strong><field name="state"/>
                        </div>
                        <div>
                            <strong>Manager: </strong><field name="manager_id"/>
                        </div>
                        <div>
                            <strong>Current Streak: </strong><field name="current_streak"/>
                            <p> Days Streak</p>
                        </div>
                        <div>
                            <strong>Missed Streak: </strong><field name="missed_streak"/>
                        </div>
                        <!-- <div invisible="state != 'offer_received'">
                            Best Price: <field name="best_price"/>
                        </div> -->
                       
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="daily_routine_checker_graph_view" model="ir.ui.view">
        <field name="name">daily.routine.checker.graph</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <graph string="Challenge Performance" type="bar">
                <field name="employee_id"/>
                <field name="current_streak" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="daily_routine_checker_search" model="ir.ui.view">
        <field name="name">daily.routine.checker.search</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="state"/>
                <filter string="Running" name="running_state" domain="[('state', '=', 'running')]"/>
            </search>
        </field>
    </record>
    <record id="daily_routine_checker_action" model="ir.actions.act_window">
        <field name="name">Daily Routine Checker</field>
        <field name="res_model">daily.routine.checker</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="daily_routine_checker.daily_routine_checker_search"/>
        <field name="context">{'search_default_running_state':1}</field>
        <field name="help" type="html">
          <p>Create a new Routine</p>
        </field>
    </record>

    <record id="view_daily_routine_checker_tree_leaderboard" model="ir.ui.view">
        <field name="name">daily.routine.checker.leaderboard.tree</field>
        <field name="model">daily.routine.checker</field>
        <field name="arch" type="xml">
            <list default_order="current_streak desc">
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="current_streak"/>
                <field name="progress"/>
            </list>
        </field>
    </record>

    <!-- Leaderboard Action -->
    <record id="action_daily_routine_checker_leaderboard" model="ir.actions.act_window">
        <field name="name">Leaderboard</field>
        <field name="res_model">daily.routine.checker</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','running')]</field>
    </record>
</odoo>