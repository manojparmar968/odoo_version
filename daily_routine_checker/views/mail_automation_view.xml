<?xml version="1.0"?>
<odoo>
    <record id="mail_automation_list_view" model="ir.ui.view">
        <field name="name">mail.automation.list</field>
        <field name="model">mail.automation</field>
        <field name="arch" type="xml">
            <list string="Mail Automation" delete="false">
                <field name="name"/>
                <field name="state"/>
                <field name="contact_ids"/>
                <field name="admin" groups="daily_routine_checker.mail_automation_admin"/>
            </list>
        </field>
    </record>
    <record id="mail_automation_form_view" model="ir.ui.view">
        <field name="name">mail.automation.form</field>
        <field name="model">mail.automation</field>
        <field name="arch" type="xml">
            <form string="Mail Automation" delete="0">
                <header>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="contact_ids" groups="daily_routine_checker.mail_automation_manager"/>
                            <field name="admin" groups="daily_routine_checker.mail_automation_admin"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="mail_automation_action" model="ir.actions.act_window">
        <field name="name">Mail Automation</field>
        <field name="res_model">mail.automation</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="rec_rule_policy_action" model="ir.actions.act_window">
        <field name="name">Access Right Testing</field>
        <field name="res_model">rec.rule.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>