<?xml version="1.0"?>
<odoo>
    <record id="topic_list_view" model="ir.ui.view">
        <field name="name">topic.list</field>
        <field name="model">topic</field>
        <field name="arch" type="xml">
            <list string="Topic" editable="bottom">
                <field name="name"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="topic_action" model="ir.actions.act_window">
        <field name="name">Topic</field>
        <field name="res_model">topic</field>
        <field name="view_mode">list</field>
    </record>
</odoo>