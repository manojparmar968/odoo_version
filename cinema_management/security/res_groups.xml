<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cinema_management_group_category" model="ir.module.category">
        <field name="name">Cinema Management</field>
    </record>
    <record id="cinema_management_sub_group_module_category" model="res.groups.privilege">
        <field name="name">Access Rights</field>
        <field name="category_id" ref="cinema_management.cinema_management_group_category"/>
        <field name="sequence">8</field>
        <field name="description">Using this group you can allow user to access below rights.
            1) User Access :- Only its own profile access.
            2) Manager access :- All Employee accessed by assigned under Employee profile.
            3) Administrator :- All Employee can see + Remove feature.
        </field>
    </record>

    <record id="cinema_manager_user_group" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="cinema_management.cinema_management_sub_group_module_category" />
    </record>
    <record id="cinema_manager_manager_group" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="cinema_management.cinema_management_sub_group_module_category"/>
    </record>
</odoo>