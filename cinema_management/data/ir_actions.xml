<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="movie_review_action_update_response" model="ir.actions.server">
            <field name="name">Update Response</field>
            <field name="model_id" ref="cinema_management.model_cinema_movie"/>
            <field name="binding_model_id" ref="cinema_management.model_cinema_movie"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.action_update_response()
            </field>
        </record>

        <record id="action_update_showing_price" model="ir.cron">
            <field name="name">Update Showing Prices</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="state">code</field>
            <field name="active" eval="False" />
            <field name="model_id" ref="cinema_management.model_movie_showing"/>
            <field name="code">model._update_showing_price()</field>
        </record>
    </data>
</odoo>