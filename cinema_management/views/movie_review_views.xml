<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- list View -->
    <record id="view_movie_review_list" model="ir.ui.view">
        <field name="name">movie.review.list</field>
        <field name="model">movie.review</field>
        <field name="arch" type="xml">
            <list string="Reviews">
                <field name="customer_id"/>
                <field name="movie_id"/>
                <field name="rating"/>
                <field name="customer_review"/>
                <field name="staff_response"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_movie_review_form" model="ir.ui.view">
        <field name="name">movie.review.form</field>
        <field name="model">movie.review</field>
        <field name="arch" type="xml">
            <form string="Reviews">
                <sheet>
                    <group>
                        <field name="customer_id"/>
                        <field name="movie_id"/>
                        <field name="rating"/>
                        <field name="customer_review"/>
                        <field name="staff_response"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_movie_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">movie.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_movie_review" name="Reviews"
        parent="menu_movie_root" action="action_movie_review" sequence="10"/>
</odoo>